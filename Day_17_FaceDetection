#Importing Library
import cv2

# Loading an image
img = cv2.imread("/usercode/photo.jpg")
resizedImage = cv2.resize(img, (1000 , 800))
imgGray = cv2.cvtColor(resizedImage, cv2.COLOR_BGR2GRAY)

#Getting the required cascade
faceCascade = cv2.CascadeClassifier("/usercode/haarcascades/haarcascade_frontalface_alt2.xml")


#Drawing rectangular contours on detected faces
scaleFactor = 1.1
minNeighbour = 4
faces = faceCascade.detectMultiScale(imgGray, scaleFactor, minNeighbour)
for (x, y, w, h) in faces:
    cv2.rectangle(resizedImage, (x, y), (x + w, y + h), (0, 0, 255), 2)

#Displaying Image
cv2.imshow("FaceDetection", resizedImage)

cv2.waitKey(0)
