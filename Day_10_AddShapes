# Import library
import cv2

# Loading an image
img = cv2.imread("/usercode/image.jpg")

# Drawing circle
center = (410, 170)
radius = 100
redColor = (0, 0, 255)
circleThickness = 5
cv2.circle(img, center, radius, redColor, circleThickness)

# Drawing rectangle
leftTopCorner = (1114, 380)
rightBottomCorner = (1726, 535)
yellowColor = (0, 255, 255)
rectangleThickness = 2
cv2.rectangle(img, leftTopCorner, rightBottomCorner, yellowColor, rectangleThickness)

# Drawing line
startPoint = (0, 0)
endPoint = (img.shape[1], img.shape[0])
whiteColor = (255, 255, 255)
lineThickness = 2
cv2.line(img,startPoint, endPoint, whiteColor, lineThickness)

# Displaying Image by resizing 
scale = 0.5
width = int(img.shape[1] * scale)
height = int(img.shape[0] * scale)
resizedImage = cv2.resize(img, (width, height))
cv2.imshow("Main", resizedImage)

cv2.waitKey(0)
