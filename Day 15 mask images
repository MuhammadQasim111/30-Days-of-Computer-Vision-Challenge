# Import library
import cv2
import numpy as np

# Loading the image
img = cv2.imread(r"/usercode/faces.jpg")

#Creating a blank image
blank = np.zeros(img.shape[:2], dtype='uint8')

#Creating a circular mask
circle = cv2.circle(blank.copy(), (img.shape[1]//2,img.shape[0]//2), 100, 255, -1)

#Creaing a retangular mask
rectangle = cv2.rectangle(blank.copy(), (30,30), (200,400), 255, -1)


#Combining those two masks
crescent_shape = cv2.bitwise_and(circle,rectangle)
cv2.imshow('Crescent_Mask', crescent_shape)


#Masking the image
masked = cv2.bitwise_and(img,img,mask=crescent_shape)


#Displaying the Masked image
cv2.imshow('CrescentMask', masked)

cv2.waitKey(0)

