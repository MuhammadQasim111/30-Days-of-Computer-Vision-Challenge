# Import library
import cv2

# Loading an image
img = cv2.imread("/usercode/image.jpg")

# Resizing image
scale = 0.5
width = int(img.shape[1] * scale)
height = int(img.shape[0] * scale)
resizedImage = cv2.resize(img, (width, height))

# Cropping image
croppedImg = img[100:500,300:600]

# Displaying Image
cv2.imshow("Main", img)
cv2.imshow("resizedImg", resizedImage)
cv2.imshow("CroppedImg", croppedImg)

cv2.waitKey(0)
