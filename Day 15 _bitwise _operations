# Import library
import cv2
import numpy as np

#Creating a blank image
blank = np.zeros((600,600), dtype='uint8')

#Creating rectangle and cricle on blanks
rectangle = cv2.rectangle(blank.copy(), (30, 30), (570, 570), 255, -1)
circle = cv2.circle(blank.copy(), (300, 300), 300, (0,0,0), -1)

cv2.imshow('Rectangle', rectangle)
cv2.imshow('Circle', circle)

# bitwise 'AND'
and_bitwise = cv2.bitwise_and(rectangle, circle)
cv2.imshow('Bitwise AND', and_bitwise)

# bitwise 'OR'
or_bitwise = cv2.bitwise_or(rectangle, circle)
cv2.imshow('Bitwise OR', or_bitwise)

# bitwise 'XOR'
xor_bitwise = cv2.bitwise_xor(rectangle, circle)
cv2.imshow('Bitwise XOR', xor_bitwise)

# bitwise 'NOT'
not_bitwise = cv2.bitwise_not(circle)
cv2.imshow('Circle NOT', not_bitwise)

