# Import library
import cv2

# Loading an image
img = cv2.imread(r"/usercode/photo.jpg")
cv2.imshow('Image', img)

#Splitting the image on the basis of color channels
b,g,r = cv2.split(img)

#Displaying the split images
cv2.imshow('Blue', b)

cv2.imshow('Green', g)

cv2.imshow('Red', r)

#Merging the split images
merged = cv2.merge([b, g, r])

#Displaying the split images
cv2.imshow('Merged Image', merged)

cv2.waitKey(0)
